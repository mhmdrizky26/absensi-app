/auth.json

# ─────────────────────────────────────────────────────────────
# Dependensi (dipasang ulang dengan composer install / npm install)
# ─────────────────────────────────────────────────────────────
/vendor
/node_modules

# ─────────────────────────────────────────────────────────────
# Hasil build frontend (dibuat ulang dengan npm run build)
# ─────────────────────────────────────────────────────────────
/public/build
/public/hot
/public/fonts-manifest.dev.json
/public/storage

# ─────────────────────────────────────────────────────────────
# Data runtime: log, cache, sesi, upload surat, kunci
